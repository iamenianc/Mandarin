{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learnhuayu.local/assets/content/schema/content-item.schema.json",
  "title": "ContentItem",
  "description": "The shared content unit for every module (docs/02-architecture.md). Pinyin carries tone numbers (ADR 0012); Hanzi never appears (ADR 0002).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "source", "meaning", "pinyin", "targetTones", "audioAssetRef"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Globally unique lowercase kebab-case id; also the audio file stem it serves."
    },
    "type": {
      "enum": ["word", "phrase", "minimalPair", "dialogue"],
      "description": "Shared type discriminator (docs/02-architecture.md)."
    },
    "source": {
      "enum": ["bundled", "generated"],
      "description": "Bundled content ships offline; generated content is produced at runtime (ADR 0010)."
    },
    "meaning": {
      "type": "string",
      "minLength": 1,
      "description": "English gloss. Meanings are unique within a module."
    },
    "pinyin": {
      "type": "string",
      "pattern": "^[a-z\u00fc]+[1-5](?: [a-z\u00fc]+[1-5])*$",
      "description": "Pinyin with a tone number 1-5 on every syllable; the neutral tone is 5 (ADR 0012)."
    },
    "targetTones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [1, 2, 3, 4, 5]
      },
      "description": "Expected tone number per syllable, in order."
    },
    "audioAssetRef": {
      "type": "string",
      "pattern": "^reference/(tones|vocabulary|listening|speech|fundamentals)/[a-z0-9]+(?:-[a-z0-9]+)*\\.(ogg|m4a|wav)$",
      "description": "Reference clip path relative to assets/audio/, following assets/audio/naming-and-formats.md."
    },
    "hangul": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[\u1100-\u11ff\u3130-\u318f\uac00-\ud7a3 ]+$",
      "description": "Optional phonetic aid; Hangul only (ADR 0004). Omitted unless it is correct."
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered turns, required for a dialogue item.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["speaker", "pinyin", "meaning", "targetTones"],
        "properties": {
          "speaker": {
            "enum": ["learner", "partner"]
          },
          "pinyin": {
            "type": "string",
            "pattern": "^[a-z\u00fc]+[1-5](?: [a-z\u00fc]+[1-5])*$"
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "targetTones": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [1, 2, 3, 4, 5]
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "dialogue"
          }
        },
        "required": ["type"]
      },
      "then": {
        "required": ["turns"]
      },
      "else": {
        "not": {
          "required": ["turns"]
        }
      }
    }
  ]
}
